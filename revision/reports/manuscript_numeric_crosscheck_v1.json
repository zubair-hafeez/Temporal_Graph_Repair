  "concrete_issues": [
    {
      "location": "main.tex:19",
      "issue": "“generated-only purchasing repair is already competitive” is underspecified and can imply consistent trial-level competition. The varied generated-only mean is 84.05% versus 85.61% for varied64, but varied64 loses to generated-only in seeds 0 and 2 (paired deltas −0.00332 and −0.00105 F1; mean delta +0.01564).",
      "suggestion": "Qualify as a higher three-seed mean with one of three paired wins, or point to the explicit qualification in results.tex:10."
    },
    {
      "location": "results.tex:23",
      "issue": "“Every tested method introduces some damage on clean records” is true at the method/domain aggregate level, but can be read as every run having damage. BPI2019 clean real-only has seed damage [9, 0, 68] and mixed-original [5, 0, 2].",
      "suggestion": "Say each method has nonzero damage over the evaluated clean runs overall / positive aggregate damage, or explicitly state that some individual runs had zero damage."
    },
    {
      "location": "results.tex:28",
      "issue": "The numeric claim that candidate coverage exceeds 85% in both applications is outside the two requested source reports and remains unverified here.",
      "suggestion": "Retain only with a source-report cross-reference or include a crosscheck against the native comparison artifact."
    }
  ]
